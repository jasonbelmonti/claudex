{
  "name": "@jasonbelmonti/claudex",
  "version": "3.0.0",
  "description": "Provider-agnostic normalized TypeScript interface over CLI-authenticated Claude, Codex, and Copilot SDKs.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/jasonbelmonti/claudex#readme",
  "bugs": {
    "url": "https://github.com/jasonbelmonti/claudex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonbelmonti/claudex.git"
  },
  "keywords": [
    "agents",
    "claude",
    "copilot",
    "codex",
    "sdk",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "imports": {
    "#test-support": "./test/support/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js",
      "default": "./dist/ingest/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit:ingest": "tsx ./scripts/ingest-audit/run-audit.ts",
    "audit:ingest:live:claude": "CLAUDEX_AUDIT_LIVE=1 vitest run test/ingest/claude-live-parity.test.ts",
    "audit:ingest:live:codex": "CLAUDEX_AUDIT_LIVE=1 vitest run test/ingest/codex-live-parity.test.ts",
    "build": "npm run build:dist && npm run build:types",
    "build:dist": "tsup --config tsup.config.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "biome lint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "CLAUDEX_SMOKE=1 vitest run ./test/smoke/codex.smoke.ts ./test/smoke/claude.smoke.ts ./test/smoke/copilot.smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "package:check": "node ./scripts/package-check.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.170",
    "@anthropic-ai/sdk": "0.104.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@github/copilot-sdk": "1.0.0-beta.9",
    "@openai/codex-sdk": "0.125.0",
    "ajv": "^8.18.0",
    "minimatch": "^10.2.5",
    "zod": "^4.0.0"
  }
}
